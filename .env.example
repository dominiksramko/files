# Generate with: openssl rand -hex 32
JWT_SECRET=

# Initial admin account (only applied on first run, when no users exist).
# If ADMIN_PASSWORD is left empty, a random password is printed to the logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: set the admin's root folder (e.g. /data/users/alice). Can be changed later in the admin panel.
ADMIN_PATH=

# The server runs as this user and group (not root); they must be able to read
# and write your files. On the host, `id -u` and `id -g` show your account's.
PUID=1000
PGID=1000
